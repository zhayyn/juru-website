# Default lokal tanpa AI, tanpa penulisan cloud, tanpa biaya provider.
HOST=127.0.0.1
PORT=3000
# Wajib hostname deployment yang tepat untuk akses non-loopback.
ALLOWED_HOSTS=127.0.0.1:3000,localhost:3000
# Wajib pada HOST non-loopback: token acak minimal 24 karakter; jangan kirim melalui URL.
# Browser akan meminta Basic auth, username tetap: prakom. HTTPS wajib di hosting.
PILOT_ACCESS_TOKEN=
# Daftar hostname target persis, dipisah koma; sertakan alias www/redirect yang disetujui.
# Tanpa wildcard, IP literal, path, query atau hostname internal.
PILOT_ALLOWED_TARGETS=
AI_PROVIDER=none
# Opsional: openrouter; hanya openrouter/free atau model berakhiran :free.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Opsional: gemini; pastikan proyek unpaid dan model memiliki free tier saat digunakan.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FREE_TIER_CONFIRMED=false
# Google PageSpeed key opsional, tetap ikuti kuota API.
PAGESPEED_API_KEY=
# Terapkan migration dan uji ACL terlebih dahulu. Service-role HANYA server!
RANKING_PUBLISH_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Key anon boleh publik untuk SELECT; jangan masukkan service-role ke VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
